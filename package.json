{
  "name": "rondine-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Worker Cloudflare per l'ingestione eventi de La Rondine — riscrittura TypeScript con architettura ad adapter",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test --ext .ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "wrangler": "^3.60.0"
  }
}
